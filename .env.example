# Public Frontend Environment Variables (Expo)
# WARNING: Never place secret API keys (Groq, Whisper, Supabase Service Key) here.
# Secret keys belong ONLY in `backend/.env`.

# Replace with your computer's local LAN IP (e.g., http://192.168.1.100:8000) when testing on a physical Android phone.
EXPO_PUBLIC_API_URL=http://localhost:8000
